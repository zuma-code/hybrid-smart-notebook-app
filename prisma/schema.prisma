// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model DailyNote {
  id        String   @id @default(cuid())
  date      String   // Format: YYYY-MM-DD (no unique, allows multiple notes per day)
  title     String?  // Optional title to differentiate notes
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Concept {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([title])
}

model Prompt {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   @default("general") // debugging, refactoring, learning, general
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isFavorite])
}

model Image {
  id        String   @id @default(cuid())
  filename  String
  path      String   @unique
  alt       String   @default("")
  createdAt DateTime @default(now())

  @@index([filename])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#3b82f6") // Hex color
  createdAt DateTime @default(now())

  noteTags NoteTag[]

  @@index([name])
}

model NoteTag {
  id        String   @id @default(cuid())
  noteType  String   // "DailyNote" | "Concept" | "Prompt"
  noteId    String
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([noteType, noteId, tagId])
  @@index([noteType, noteId])
  @@index([tagId])
}

model NoteLink {
  id          String   @id @default(cuid())
  fromNoteType String // "DailyNote" | "Concept"
  fromNoteId   String
  toNoteType   String // "DailyNote" | "Concept"
  toNoteId     String
  linkType     String @default("reference") // reference, related, etc.
  createdAt    DateTime @default(now())

  @@unique([fromNoteType, fromNoteId, toNoteType, toNoteId])
  @@index([fromNoteType, fromNoteId])
  @@index([toNoteType, toNoteId])
}
